{
  "name": "career-compass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Demo v1: a compass that points at people worth working with, then hands off to LinkedIn.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server.mjs",
    "start": "node server.mjs",
    "phones": "node dev/phones.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "mock-signin": "node dev/mock-oidc.mjs",
    "mock-linkedin": "node dev/mock-linkedin.mjs",
    "snowflake:check": "node snowflake/check.mjs",
    "db:check": "node postgres/check.mjs",
    "users": "node postgres/users.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "playwright-core": "1.65.0"
  }
}
