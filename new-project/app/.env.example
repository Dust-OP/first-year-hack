# Copy to .env (never commit .env). Without the SNOWFLAKE_* values the app
# uses the in-memory store, which is enough for a single-laptop demo.

PORT=3000

# Demo mode is ON unless this is 0: "Add demo people", the demo position, and quick sign-up next to real sign-in.
DEMO=1

# --- Sign in with a code we email ourselves (optional). With RESEND_API_KEY set,
# the welcome screen asks for an email address, emails a 6-digit code from
# MAIL_FROM through Resend, and replaces the Logto button. Use a Resend key with
# "Sending access" for the one domain only. Codes and send limits live in the
# server's memory: only run this with `npm start` (one process), never on a
# serverless or multi-instance host. Quote MAIL_FROM (it contains < and >).
RESEND_API_KEY=
MAIL_FROM="Wayrise <hello@wayrise.app>"
# Name used in the email ("123456 is your <APP_NAME> sign-in code").
APP_NAME=Career Compass

# --- Sign-in with Logto (optional). Without LOGTO_APP_ID the app uses its
# quick sign-up with no email check. The App ID is not a secret.
# In the Logto console the app must be a "Single Page App" with redirect URI
# <app address>/callback and post sign-out redirect URI <app address>.
LOGTO_ENDPOINT=https://auth.dustpowered.studio
LOGTO_APP_ID=

# --- Sign in with LinkedIn (optional). Needs BOTH values; without them the button
# is not shown and the app works exactly as before. NOT YET RUN against the real
# LinkedIn (only against the local stand-in, see LINKEDIN_MOCK_URL below).
# Setup, at https://www.linkedin.com/developers/apps :
#   1. Create an app. (The form asks for a LinkedIn Page to attach it to.)
#   2. Products tab: request "Sign In with LinkedIn using OpenID Connect".
#      It is self-service and gives the scopes openid, profile and email.
#   3. Auth tab, "Authorized redirect URLs": add  <app address>/api/linkedin/callback
#      once for every address the app is opened from, written exactly, e.g.
#        http://localhost:3000/api/linkedin/callback
#        https://<the https address used on phones>/api/linkedin/callback
#   4. Auth tab: copy the Client ID and the Client Secret here.
# The secret is used only by the server (lib/linkedin.mjs) and is never sent to a
# browser. Never commit it, and never put it in a URL.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Local stand-in for LinkedIn, for trying the flow with no LinkedIn app:
#   npm run mock-linkedin   then set the three values it prints. Local testing only.
# LINKEDIN_MOCK_URL=http://localhost:3298

# The app's own public address, used to build the LinkedIn redirect URL. Leave it
# empty to use whatever address each browser came in on. `npm run phones` sets it
# to the tunnel address by itself.
PUBLIC_URL=

# --- Postgres (optional; used on Vercel). Set by the Neon integration;
# `vercel env pull .env.local` copies it here for `npm run db:check`.
# When set it wins over Snowflake.
DATABASE_URL=

# --- Snowflake (optional). Run snowflake/setup.sql first. ---
# Account identifier as it appears in the URL, e.g. myorg-myaccount
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=COMPASS_SVC
SNOWFLAKE_ROLE=COMPASS_APP_ROLE
SNOWFLAKE_WAREHOUSE=COMPASS_WH
SNOWFLAKE_DATABASE=COMPASS_DB
SNOWFLAKE_SCHEMA=APP
# Auth, pick one:
#   key pair: path to the PKCS#8 private key file (keep it outside the repo)
SNOWFLAKE_PRIVATE_KEY_PATH=
#   or a programmatic access token
SNOWFLAKE_PAT=
