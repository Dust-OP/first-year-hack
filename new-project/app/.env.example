# Copy to .env (never commit .env). Without the SNOWFLAKE_* values the app
# uses the in-memory store, which is enough for a single-laptop demo.

PORT=3000

# Set to 1 to allow "Add demo people" (bots placed around the caller).
DEMO=1

# --- Snowflake (optional). Run snowflake/setup.sql first. ---
# Account identifier as it appears in the URL, e.g. myorg-myaccount
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=COMPASS_SVC
SNOWFLAKE_ROLE=COMPASS_APP_ROLE
SNOWFLAKE_WAREHOUSE=COMPASS_WH
SNOWFLAKE_DATABASE=COMPASS_DB
SNOWFLAKE_SCHEMA=APP
# Auth, pick one:
#   key pair: path to the PKCS#8 private key file (keep it outside the repo)
SNOWFLAKE_PRIVATE_KEY_PATH=
#   or a programmatic access token
SNOWFLAKE_PAT=
